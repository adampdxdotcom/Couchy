# Copy this file to .env before running docker compose:
#   cp example.env .env

# Server Port inside container
PORT="8080"

# ComfyUI Connection URL (supports LAN or another Docker host without Docker socket)
COMFYUI_URL="http://comfyui:8188"

# LM Studio Local LLM OpenAI-Compatible Endpoint (used by Generation Studio Photo Set Agent)
LM_STUDIO_URL="http://host.docker.internal:1234/v1"

# Mounted Read-Only ComfyUI Output Directory (never modified or moved)
COMFYUI_OUTPUT_DIR="/data/output"

# Mounted Read-Only ComfyUI Models Directory
COMFYUI_MODELS_DIR="/data/models"

# Persistent Application Database, WebP Thumbnail Cache & Backups
DATABASE_PATH="/app/data/gallery.db"
THUMBNAIL_PATH="/app/data/thumbnails"
BACKUP_PATH="/app/data/backups"

# Writable Model Downloads Directory
DOWNLOADS_DIR="/downloads"

# Optional API Keys for Model Downloads (kept strictly server-side)
CIVITAI_API_KEY=""
HF_API_TOKEN=""
